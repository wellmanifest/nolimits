# Wellmanifest NoLimits Decision Rules (Env DSL v1)
# Formal predicate equations for unblocking host execution limits during planfile sprints.

RULE_STORAGE_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-STORAGE-001||(@FACT_TOOL==:SEMCOD_FIXOS&&@FACT_STORAGE_CLEANUP_SUCCEEDED&&@FACT_AVAILABLE_GB>=10)
RULE_TEST_BLOAT_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-TEST-002||(@FACT_TOOL==:SEMCOD_TESTLESS&&(@FACT_DEAD_TESTS_PRUNED||@FACT_TARGETED_SCAN_BUDGET_MET))
RULE_MERGE_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-MERGE-003||(@FACT_TOOL==:SUBACTOR_VALIDATOR_AGENT&&@FACT_ALL_TESTS_GREEN&&@FACT_VALIDATOR_APPROVED&&!@FACT_ADMIN_BYPASS_USED)
RULE_WORKTREE_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-WORKTREE-004||(@FACT_TOOL==:WELLMANIFEST_WORKTREES&&@FACT_LEASE_ALLOCATED&&@FACT_WORKTREE_ISOLATED&&!@FACT_MAIN_EDITED)
RULE_DEPENDENCY_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-DEPENDENCY-005||(@FACT_TOOL==:SEMCOD_PACTFIX&&@FACT_VENV_RESOLVED&&@FACT_IMPORTS_VERIFIED)
RULE_RESOURCE_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-RESOURCE-006||(@FACT_TOOL==:WELLMANIFEST_HOSTGUARD&&@FACT_ZOMBIES_CLEANED&&@FACT_PRESERVE_IDE_ACTIVE)
RULE_CONTEXT_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-CONTEXT-007||(@FACT_TOOL==:SEMCOD_CODE2LLM&&@FACT_AST_DISTILLED&&@FACT_TOKENS_REDUCED)
RULE_FLAKY_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-FLAKY-008||(@FACT_TOOL==:SEMCOD_TESTWINS&&@FACT_QUARANTINE_RECORDED)
RULE_GOVERNANCE_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-GOVERNANCE-009||(@FACT_TOOL==:WELLMANIFEST_NEW_PROJECT&&@FACT_GATE_PASSED)
RULE_COST_UNBLOCK_CONDITION=@FACT_LIMIT!=:LIM-COST-010||(@FACT_TOOL==:SEMCOD_COSTS&&@FACT_PROVIDER_ROTATED)

NOLIMITS_PLANFILE_RESUME_ADMISSIBLE=@RULE_STORAGE_UNBLOCK_CONDITION&&@RULE_TEST_BLOAT_UNBLOCK_CONDITION&&@RULE_MERGE_UNBLOCK_CONDITION&&@RULE_WORKTREE_UNBLOCK_CONDITION&&@RULE_DEPENDENCY_UNBLOCK_CONDITION&&@RULE_RESOURCE_UNBLOCK_CONDITION&&@RULE_CONTEXT_UNBLOCK_CONDITION&&@RULE_FLAKY_UNBLOCK_CONDITION&&@RULE_GOVERNANCE_UNBLOCK_CONDITION&&@RULE_COST_UNBLOCK_CONDITION
